# Application Configuration
APP_NAME="IntelliTicket - Intelligent Service Request & Prioritization System"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=intelliticket_db

# SLA Defaults (in hours)
SLA_P1_HOURS=2
SLA_P2_HOURS=6
SLA_P3_HOURS=24
SLA_P4_HOURS=72

# CORS Configuration (comma-separated or * for dev)
CORS_ORIGINS=*
